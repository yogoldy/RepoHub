# Generated app and runtime files
__pycache__/
*.pyc
.DS_Store
.build/
*.app/
.venv/
venv/

# Local environment values; examples must contain placeholders only
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Credentials and signing material
secrets/
credentials/
*.pem
*.key
*.p12
*.pfx
*.keychain
*.keychain-db

# Private runtime state and diagnostic output
state/
runtime/
data/
diagnostics/
reports/
staging/
*.log
*.jsonl

# Backup/restore inputs and results stay outside public source control
backups/
restore-inputs/
restore-output/
*.tar
*.tar.gz
*.tgz
*.zip
